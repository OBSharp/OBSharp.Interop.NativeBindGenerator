<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackAsTool>True</PackAsTool>
    <RuntimeIdentifiers>linux-arm64;linux-x64;osx-arm64;win-arm64;win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' == ''">
    <IncludeSymbols>false</IncludeSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClangSharp" />
    <PackageReference Include="DotMake.CommandLine" />
    <PackageReference Include="Humanizer.Core" />
  </ItemGroup>

  <ItemGroup>
    <!-- native 侧转换头文件随程序集发布，需要时从资源流释放到输出目录 -->
    <EmbeddedResource Include="cpp_shim_marshal.hpp" />
    <EmbeddedResource Include="qt_shim_marshal.hpp" />
  </ItemGroup>

</Project>
